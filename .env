# ─── Ports ─────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
PORT=8080

# ─── Discord ───────────────────────────────────────────────
# Your Discord user ID (right-click your profile → Copy User ID)
DISCORD_USER_ID=417628102831767566

# Discord bot token (REQUIRED - connects to Gateway for real-time presence)
# Create a bot at https://discord.com/developers/applications
# Enable "Presence Intent" and "Server Members Intent" in Bot settings
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Guild (server) ID where your bot and you are both members
# Right-click the server → Copy Server ID
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID_HERE

# ─── Spotify ──────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE

# Get a refresh token via OAuth2 flow:
# 1. Open: https://accounts.spotify.com/authorize?client_id=YOUR_CLIENT_ID&response_type=code&redirect_uri=http://localhost:8888/callback&scope=user-read-currently-playing%20user-read-playback-state
# 2. Copy the 'code' from the redirect URL
# 3. Exchange it: curl -X POST https://accounts.spotify.com/api/token -H "Authorization: Basic BASE64(client_id:client_secret)" -d "grant_type=authorization_code&code=YOUR_CODE&redirect_uri=http://localhost:8888/callback"
# 4. Copy the refresh_token from the response
SPOTIFY_REFRESH_TOKEN=YOUR_SPOTIFY_REFRESH_TOKEN_HERE
